# --- LLM (Groq — https://console.groq.com/keys) ---
# Groq and xAI/Grok are both OpenAI-compatible; whichever *_API_KEY is
# present wins, and the base URL + model default to that provider.
# Add GROQ_BASE_URL / GROQ_MODEL to override the defaults.
GROQ_API_KEY=your-groq-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b

# ...or use xAI instead (delete the Groq key above):
# GROK_API_KEY=xai-your-key-here
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-4-fast

# --- Pexels (stock footage) ---
PEXELS_API_KEY=your-pexels-key-here

# --- Facebook Graph API (Page video posting) ---
FACEBOOK_APP_ID=your-app-id
FACEBOOK_PAGE_ID=your-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token
FACEBOOK_GRAPH_VERSION=v21.0

# --- LinkedIn API (video posting) ---
# Personal profile: set MEMBER_ID (the numeric part of urn:li:person:<id>)
# with the w_member_social scope. For an org, set LINKEDIN_ORG_URN instead
# with w_organization_social + r_organization_social.
LINKEDIN_MEMBER_ID=1234567
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_API_VERSION=202405
# LINKEDIN_ORG_URN=urn:li:organization:1234567

# --- Reel length window (seconds) ---
# The finished file is guaranteed to land inside MIN..MAX: the render node
# measures the real synthesized narration and corrects pacing to fit.
MIN_REEL_SECONDS=20
TARGET_REEL_SECONDS=25
MAX_REEL_SECONDS=30
WORDS_PER_SECOND=2.4

# --- Narration (edge-tts — free, no API key) ---
# British English voice reads nautical terms correctly. Any
# https://speech.platform.bing.com/consumer/voices/ssml/voices/list.html
# name works.
TTS_VOICE=en-GB-SoniaNeural
TTS_RATE=+8%

# --- Burned-in captions (requires ffmpeg built with libass) ---
CAPTIONS_ENABLED=true
CAPTION_FONT=C:\Windows\Fonts\arialbd.ttf
CAPTION_FONT_SIZE=64
CAPTION_OUTLINE=4
CAPTION_MARGIN_V=260
CAPTION_MAX_CHARS=26

# --- Daily automation (in-process APScheduler cron) ---
# DAILY_RUN_TIMEZONE must be an IANA zone name ("Asia/Kolkata"), NOT a
# Windows zone id ("India Standard Time") — APScheduler raises
# ZoneInfoNotFoundError on the latter.
DAILY_RUN_ENABLED=false
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0
DAILY_RUN_TIMEZONE=Asia/Kolkata

# --- Comma-separated RSS sources ---
# Defaults to the maritime set in app/config.py; set this to override.
# RSS_FEEDS=https://gcaptain.com/feed/,https://theloadstar.com/feed/

# --- Server ---
PORT=8000
